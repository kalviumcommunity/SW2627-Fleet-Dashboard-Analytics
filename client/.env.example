# ==========================================
# SW2627 Fleet Dashboard Analytics - Environment Template
# ==========================================

# Node Environment
NODE_ENV=production
PORT=3000

# ------------------------------------------
# Supabase (Authentication & Database)
# ------------------------------------------
# Found in: Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side Supabase Service Role Key (Keep private! Used for admin / seeding scripts)
SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------
# Mappls / MapmyIndia Maps SDK
# ------------------------------------------
# Found in: Mappls Developer Dashboard
NEXT_PUBLIC_MAPPLS_KEY=your-mappls-api-key
# Alternative key name supported:
# NEXT_PUBLIC_MAPMYINDIA_API_KEY=your-mappls-api-key

# ------------------------------------------
# Database Connection (Optional / Prisma)
# ------------------------------------------
# Used if connecting directly via Prisma to Supabase Postgres, Render Postgres, or local Docker
DATABASE_URL=postgresql://fleetuser:fleetpass@localhost:5432/fleetdb
